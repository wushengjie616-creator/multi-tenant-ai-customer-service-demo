# 复制为 .env 后可覆盖默认值；默认值已内置于 docker-compose.yml，不复制也能一键启动。

# App
APP_ENV=development
LOG_LEVEL=INFO
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
API_PORT=8000
API_REPLICA_PORT=8001
API_REPLICA_2_PORT=8002

# PostgreSQL（compose 内服务名 host）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=eduai
POSTGRES_PASSWORD=eduai_password
POSTGRES_DB=eduai
DATABASE_URL=postgresql+asyncpg://eduai:eduai_password@postgres:5432/eduai
DATABASE_URL_SYNC=postgresql+psycopg2://eduai:eduai_password@postgres:5432/eduai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=10

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
CONTEXT_MAX_MESSAGES=20
CONTEXT_TTL_SECONDS=3600

# NATS JetStream
NATS_URL=nats://nats:4222
WORKER_CONCURRENCY=32
WORKER_FETCH_BATCH=128
WORKER_METRICS_PORT=9101
METRICS_COLLECTION_SECONDS=5
PROMETHEUS_PORT=9090

# Qdrant 向量库
QDRANT_URL=http://qdrant:6333

# OpenTelemetry OTLP/HTTP collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_HTTP_PORT=4318

# JWT（仅本地开发演示；生产必须替换 secret 并从密钥管理系统注入）
JWT_SECRET=dev_secret_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TENANT_RATE_LIMIT_PER_MINUTE=600
USER_RATE_LIMIT_PER_MINUTE=120

# Mock 依赖（服务名 host）
MOCK_IM_URL=http://mock-im:8100
MOCK_LLM_URL=http://mock-llm:8101
MOCK_KNOWLEDGE_URL=http://mock-knowledge:8102
MOCK_PLATFORM_URL=http://mock-platform:8103
MOCK_FINANCE_URL=http://mock-finance:8104

# DeepSeek（OpenAI 兼容接口）
# 不填 key 时，下方 URL 保持 mock-llm 即可离线演示。使用 DeepSeek 时同时替换 URL / KEY / MODEL。
# 模型名按你 DeepSeek 账号实际可用的填写（如 deepseek-flash / deepseek-chat）。
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=800
LLM_GLOBAL_MAX_INFLIGHT=600
LLM_GLOBAL_STARTS_PER_SECOND=20
# 按 DeepSeek 账号实际价格填写每百万 token 美元单价；0 表示只统计 token、不估算费用。
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

# Docker 容器访问公网 API 的 DNS（某些 Docker Desktop 环境不会自动继承宿主机 DNS）
DOCKER_DNS_PRIMARY=223.5.5.5
DOCKER_DNS_SECONDARY=1.1.1.1

# 本地面试演示（非演示环境请设 DEMO_MODE=false）
DEMO_MODE=true
DEMO_TENANT_ID=10000000-0000-0000-0000-000000000001
DEMO_TENANT_NAME=云杉学业服务中心
DEMO_ADMIN_USER_ID=10000000-0000-0000-0000-000000000100
DEMO_ADMIN_CONVERSATION_ID=10000000-0000-0000-0000-000000000200
DEMO_TENANT_ADMIN_EMAIL=admin@example.com
DEMO_TENANT_ADMIN_PASSWORD=change_me
# 客户一键示例使用独立的固定租户，不会读取上方工作台租户的临时上传。
DEMO_CUSTOMER_TENANT_ID=20000000-0000-0000-0000-000000000001
DEMO_CUSTOMER_TENANT_NAME=星河未来成长中心
DEMO_CUSTOMER_USER_ID=20000000-0000-0000-0000-000000000101
DEMO_CUSTOMER_CONVERSATION_ID=20000000-0000-0000-0000-000000000201
DEMO_CUSTOMER_EMAIL=lin-parent@xinghe-future.example.com
DEMO_CUSTOMER_KNOWLEDGE_ROOT=sample-data/tenants/xinghe-future
DEMO_MAX_UPLOAD_CHARS=200000

# 中文全文兜底每次最多扫描的当前租户知识分块数
KNOWLEDGE_LEXICAL_SCAN_LIMIT=500
RAG_SEMANTIC_CANDIDATE_LIMIT=40
